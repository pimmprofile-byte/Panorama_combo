# 이 파일을 .env 로 복사해 쓰세요. .env 는 커밋되지 않습니다(.gitignore).
#
# 좌석이 전부 사람이라 LLM 키가 필요 없습니다. 아래 셋만 있으면 됩니다.

# ── 서버 ──
# 0.0.0.0 = 같은 와이파이의 다른 기기(폰·PC)에서 접속 허용
# 127.0.0.1 로 두면 이 컴퓨터에서만 접속 가능
REUNION_HOST=0.0.0.0
REUNION_PORT=8790

# ── 진행석 원격 조종 키 ──
# 코드 세션이 진행석(/api/gm · 마킹 · 페이즈 넘기기)을 원격으로 잡을 때 쓰는 임의 문자열.
# 비워두면 잠금 없이 열립니다 — 집에서 도는 판이면 비워도 됩니다.
AGENT_KEY=

# ── 사건 고르기 ──
# 서버가 켜질 때 열 사건. 비우면 scenarios/__init__.py 의 첫 번째가 열립니다.
SCENARIO=
