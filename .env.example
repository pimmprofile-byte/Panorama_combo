# ── AI 백엔드 선택 ──
# claude = Claude API (기본, 한국어·연기 최상, 종량 과금)
# ollama = 로컬 무료 모델 (오프라인, 한국어는 qwen2.5 권장)
LLM_BACKEND=claude

# ── Claude API (키는 서버측에만 보관 · 브라우저에 절대 노출 금지) ──
ANTHROPIC_API_KEY=sk-ant-...
# 종막 채점과 AI 종막 답안에만 쓰입니다. 판당 예닐곱 번.
# 빠르고 저렴하게 돌리려면 claude-sonnet-5 로 바꿔도 됩니다.
REUNION_MODEL=claude-opus-4-8
# 배역 대사 전용 모델. 판당 60~100번 불리는 자리라 여기가 비용과 체감속도를 좌우합니다.
# 기본값이 이미 하이쿠입니다 — 대사가 밋밋하면 claude-sonnet-5 로 올려보세요.
PIMM_MODEL_FAST=claude-haiku-4-5-20251001

# ── 로컬 Ollama (LLM_BACKEND=ollama 일 때만) ──
# 설치: https://ollama.com
# 한국어 연기는 EXAONE(LG, 한국어 특화)이 같은 크기에서 가장 낫습니다.
#   ollama pull exaone3.5:7.8b     ← 8GB VRAM / M2 16GB 정도면 돌아감
#   ollama pull exaone3.5:32b      ← 24GB VRAM 이상. 사람 같아지는 건 이 급부터
#   ollama pull qwen2.5:14b        ← 지시 준수는 이쪽이 더 단단함(한국어는 한 끗 아래)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=exaone3.5:7.8b
# 배역 프롬프트가 5천 토큰이 넘습니다. 이 값을 줄이면 대본 앞쪽이 잘린 채로 연기합니다.
OLLAMA_CTX=8192

# ── 서버 ──
# 0.0.0.0 = 같은 와이파이의 다른 기기(폰·PC)에서 접속 허용
# 127.0.0.1 로 두면 이 컴퓨터에서만 접속 가능
REUNION_HOST=0.0.0.0
REUNION_PORT=8790
